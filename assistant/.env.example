APP_NAME=ShopSmart RAG Assistant
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Primary PostgreSQL + pgvector connection
DATABASE_URL=postgresql+psycopg://shopsmart_user:CHANGE_ME@localhost:5432/shopsmart
ADMIN_API_KEY=CHANGE_TO_SECURE_ADMIN_KEY

# Embedding configuration
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# LLM provider configuration
LLM_PROVIDER=auto
LLM_MODEL=gemini-1.5-flash
GOOGLE_API_KEY=

# RAG hyperparameters
CHUNK_SIZE=500
CHUNK_OVERLAP=75
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.35
