# --- Primary: Postgres (default) ---
# Local Postgres:
# DATABASE_URL=postgresql+psycopg2://shopsmart:shopsmart@localhost:5432/shopsmart
# Or parts (used when DATABASE_URL is unset):
# POSTGRES_USER=shopsmart
# POSTGRES_PASSWORD=shopsmart
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=shopsmart

# --- Fallback: SQLite (tests / no-Postgres environments) ---
# SQLITE_URL=sqlite:///./shopsmart.db

PORT=8000
